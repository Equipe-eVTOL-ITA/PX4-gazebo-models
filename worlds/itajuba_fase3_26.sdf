<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="itajuba_fase3_26">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-23.203008</latitude_deg>
      <longitude_deg>-45.874897</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds />
      </sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <ambient>0.8 0.8 0.8 1</ambient>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>250 250</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="grass">
          <pose>0 0 0 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>file://grass_plane/meshes/grass_plane.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Decolagem Base 1 (blue circle at origin) -->
    <model name="takeoff_base_1">
      <include>
        <uri>model://takeoff_base</uri>
        <pose>0.0 0.0 0 0 0 0</pose>
      </include>
    </model>

    <!-- Decolagem Base 2 (blue circle) -->
    <model name="takeoff_base_2">
      <include>
        <uri>model://takeoff_base</uri>
        <pose>0.0 -4.0 0 0 0 0</pose>
      </include>
    </model>

    <!-- Decolagem Base 3 (blue circle) -->
    <model name="takeoff_base_3">
      <include>
        <uri>model://takeoff_base</uri>
        <pose>0.0 -8.0 0 0 0 0</pose>
      </include>
    </model>

    <!-- Pacote Base 1 (yellow square with blue border and center cross) -->
    <model name="package_base_1">
      <include>
        <uri>model://package_base</uri>
        <pose>4.0 0.0 0 0 0 0</pose>
      </include>
    </model>

    <!-- Pacote Base 2 (yellow square with blue border and center cross) -->
    <model name="package_base_2">
      <include>
        <uri>model://package_base</uri>
        <pose>4.0 -4.0 0 0 0 0</pose>
      </include>
    </model>

    <!-- Pacote Base 3 (yellow square with blue border and center cross) -->
    <model name="package_base_3">
      <include>
        <uri>model://package_base</uri>
        <pose>4.0 -8.0 0 0 0 0</pose>
      </include>
    </model>

    <!-- First Aid Kit 1 -->
    <model name="first_aid_kit_1">
      <include>
        <uri>model://first_aid_kit</uri>
        <pose>4.0 0.0 0.1 0 0 0</pose>
      </include>
    </model>

    <!-- First Aid Kit 2 -->
    <model name="first_aid_kit_2">
      <include>
        <uri>model://first_aid_kit</uri>
        <pose>4.0 -4.0 0.1 0 0 0</pose>
      </include>
    </model>

    <!-- First Aid Kit 3 -->
    <model name="first_aid_kit_3">
      <include>
        <uri>model://first_aid_kit</uri>
        <pose>4.0 -8.0 0.1 0 0 0</pose>
      </include>
    </model>

    <!-- Destination Box 1 -->
    <model name="destination_box_1">
      <include>
        <uri>model://destination_box_open</uri>
        <pose>8.0 0 0 0 0 0</pose>
      </include>
    </model>

    <!-- Destination Box 2 -->
    <model name="destination_box_2">
      <include>
        <uri>model://destination_box_open</uri>
        <pose>8.0 -4.0 0 0 0 0</pose>
      </include>
    </model>

    <!-- Destination Box 3 -->
    <model name="destination_box_3">
      <include>
        <uri>model://destination_box_open</uri>
        <pose>8.0 -8.0 0 0 0 0</pose>
      </include>
    </model>

  </world>
</sdf>
